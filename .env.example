# Copier ce fichier vers .env.local et remplir uniquement ce dont la phase en cours a besoin.
# Aucune de ces valeurs n'est nécessaire pour le mode démo ni pour les cours (Yahoo, sans clé).

# Phase 3 : composition des ETF. Sans aucune clé, Yahoo (top 10 + secteurs) est utilisé.
# Une clé Eulerpool gratuite ajoute les lignes complètes et les pays. Valeurs : yahoo, eulerpool, fmp, finnhub.
HOLDINGS_PROVIDER=
EULERPOOL_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# Aucune clé d'IA : la phrase du jour, le chat et l'import par capture fonctionnent sans service externe.

# Comptes (facultatif) : sans ces variables, l'app reste ouverte et les données restent sur l'appareil.
# Une ligne par compte via : node scripts/hash-password.mjs <identifiant> "<Prénom>"
ATLAS_USERS=
# Facultatif : sans lui, le secret de session est dérivé de KV_REST_API_TOKEN.
ATLAS_SESSION_SECRET=
# Ajoutées automatiquement par l'intégration Upstash for Redis de Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
