# Copier ce fichier vers .env.local et remplir uniquement ce dont la phase en cours a besoin.
# Aucune de ces valeurs n'est nécessaire pour le mode démo ni pour les cours (Yahoo, sans clé).

# Phase 3 : composition des ETF. Valeurs possibles : eulerpool, fmp, finnhub.
HOLDINGS_PROVIDER=eulerpool
EULERPOOL_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# Phase 5 : IA (chat, import par capture d'écran, tournure de la phrase du jour).
# Offre gratuite de l'API Gemini : clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
